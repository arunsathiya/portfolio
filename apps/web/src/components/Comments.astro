---
interface Props {
	slug: string;
}

const { slug } = Astro.props;
---

<div class='comments-section' data-post-slug={slug}>
	<h3 data-role='title' class='text-base lg:text-sm font-semibold mb-4 text-zinc-800 dark:text-zinc-200 uppercase tracking-wide'>
		Comments
	</h3>

	<div data-role='status' aria-live='polite' class='bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-lg p-4 text-left'>
		<p class='text-sm text-zinc-600 dark:text-zinc-400'>Loading comments…</p>
	</div>

	<div data-role='list' class='hidden space-y-3'></div>

	<!-- Comment Form -->
	<div class='mt-6'>
		<div data-role='login' class='flex justify-start p-3 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-lg'>
			<button
				data-role='login-btn'
				class='flex items-center justify-center gap-2 px-3 py-1.5 text-sm bg-zinc-900 dark:bg-zinc-600 text-white border border-zinc-800 dark:border-zinc-500 rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-500 transition-colors font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-800'
			>
				<svg class='w-3.5 h-3.5' fill='currentColor' viewBox='0 0 24 24' aria-hidden='true'>
					<path
						d='M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z'
					></path>
				</svg>
				Sign in with GitHub
			</button>
		</div>

		<!-- Comment Form (hidden until signed in) -->
		<div data-role='form' class='hidden p-3 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-lg'>
			<div class='flex items-center gap-2 mb-3'>
				<img data-role='user-avatar' class='w-6 h-6 rounded-full' alt='User avatar' />
				<div class='flex-1 min-w-0'>
					<div data-role='user-name' class='font-medium text-sm text-zinc-800 dark:text-zinc-200 truncate'></div>
				</div>
				<button data-role='logout-btn' class='text-xs text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500'>
					Sign out
				</button>
			</div>

			<textarea
				data-role='input'
				name='comment'
				aria-label='Comment'
				autocomplete='off'
				maxlength='1000'
				placeholder='Write your comment…'
				class='w-full h-20 p-2 text-sm border border-zinc-300 dark:border-zinc-600 rounded-lg bg-white dark:bg-zinc-700 text-zinc-800 dark:text-zinc-200 placeholder-zinc-500 dark:placeholder-zinc-400 resize-none focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'
			></textarea>

			<div class='flex justify-between items-center mt-2'>
				<div class='text-xs text-zinc-500 dark:text-zinc-400'>
					<span data-role='char-count'>0</span>/1000
				</div>
				<button
					data-role='post-btn'
					class='px-3 py-1.5 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-800'
					disabled
				>
					Post
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	import { createClient, type User } from '@supabase/supabase-js';

	type Comment = {
		id: string;
		content: string;
		created_at: string;
		author_name: string;
		author_avatar: string | null;
	};

	const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
	const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

	// The post page renders this component twice (mobile and desktop layouts).
	// Everything below works on all instances, with one client and one fetch.
	const sections = Array.from(document.querySelectorAll<HTMLElement>('.comments-section'));
	const postSlug = sections[0]?.dataset.postSlug ?? '';

	const all = <T extends Element>(role: string) =>
		sections.map((section) => section.querySelector<T>(`[data-role='${role}']`)).filter((el): el is T => el !== null);

	const formatDate = (dateString: string) =>
		new Date(dateString).toLocaleDateString('en-US', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			hour: '2-digit',
			minute: '2-digit',
		});

	function renderComment(comment: Comment) {
		const commentElement = document.createElement('div');
		commentElement.className = 'bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-lg p-3 hover:shadow-sm transition-shadow';

		const flexDiv = document.createElement('div');
		flexDiv.className = 'flex items-start space-x-2';

		const avatarImg = document.createElement('img');
		avatarImg.src = comment.author_avatar || '/default-avatar.svg';
		avatarImg.alt = comment.author_name;
		avatarImg.className = 'w-6 h-6 rounded-full flex-shrink-0';

		const contentContainer = document.createElement('div');
		contentContainer.className = 'flex-1 min-w-0';

		const headerDiv = document.createElement('div');
		headerDiv.className = 'flex flex-wrap items-center gap-x-2 gap-y-0 mb-1';

		const nameSpan = document.createElement('span');
		nameSpan.className = 'font-medium text-sm text-zinc-800 dark:text-zinc-200';
		nameSpan.textContent = comment.author_name;

		const dateSpan = document.createElement('span');
		dateSpan.className = 'text-xs text-zinc-500 dark:text-zinc-400';
		dateSpan.textContent = formatDate(comment.created_at);

		headerDiv.append(nameSpan, dateSpan);

		// textContent, never innerHTML: comment text is user input
		const commentContentDiv = document.createElement('div');
		commentContentDiv.className = 'text-sm text-zinc-700 dark:text-zinc-300 whitespace-pre-line break-words';
		commentContentDiv.textContent = comment.content;

		contentContainer.append(headerDiv, commentContentDiv);
		flexDiv.append(avatarImg, contentContainer);
		commentElement.append(flexDiv);
		return commentElement;
	}

	let count = 0;

	function setStatus(message: string | null, isError = false) {
		for (const status of all<HTMLElement>('status')) {
			status.classList.toggle('hidden', message === null);
			const p = status.querySelector('p');
			if (p && message !== null) {
				p.textContent = message;
				p.className = isError ? 'text-sm text-red-700 dark:text-red-300' : 'text-sm text-zinc-600 dark:text-zinc-400';
			}
		}
	}

	function addComments(comments: Comment[]) {
		count += comments.length;
		for (const list of all<HTMLElement>('list')) {
			list.append(...comments.map(renderComment));
			list.classList.toggle('hidden', count === 0);
		}
		for (const title of all<HTMLElement>('title')) title.textContent = `Comments (${count})`;
		setStatus(count === 0 ? 'No comments yet. Be the first to share your thoughts!' : null);
	}

	function showSignedIn(user: User | null) {
		for (const login of all<HTMLElement>('login')) login.classList.toggle('hidden', !!user);
		for (const form of all<HTMLElement>('form')) form.classList.toggle('hidden', !user);
		if (!user) return;

		const meta = user.user_metadata;
		for (const avatar of all<HTMLImageElement>('user-avatar')) avatar.src = meta.avatar_url || '/default-avatar.svg';
		for (const name of all<HTMLElement>('user-name')) name.textContent = meta.full_name || meta.name || meta.user_name || 'Anonymous';
	}

	if (!supabaseUrl || !supabaseAnonKey || sections.length === 0) {
		setStatus('Comments are unavailable right now.', true);
	} else {
		const supabase = createClient(supabaseUrl, supabaseAnonKey);

		supabase
			.from('comments')
			.select('id, content, created_at, author_name, author_avatar')
			.eq('post_slug', postSlug)
			.order('created_at', { ascending: true })
			.then(({ data, error }) => {
				if (error) {
					console.error('Error fetching comments:', error);
					setStatus('Unable to load comments.', true);
				} else {
					addComments(data ?? []);
				}
			});

		// Fires INITIAL_SESSION on load, then on every sign in or out
		supabase.auth.onAuthStateChange((_event, session) => showSignedIn(session?.user ?? null));

		for (const btn of all<HTMLButtonElement>('login-btn')) {
			btn.addEventListener('click', async () => {
				const { error } = await supabase.auth.signInWithOAuth({
					provider: 'github',
					options: { redirectTo: window.location.href },
				});
				if (error) console.error('GitHub login error:', error);
			});
		}

		for (const btn of all<HTMLButtonElement>('logout-btn')) {
			btn.addEventListener('click', async () => {
				const { error } = await supabase.auth.signOut();
				if (error) console.error('Logout error:', error);
			});
		}

		for (const section of sections) {
			const input = section.querySelector<HTMLTextAreaElement>("[data-role='input']")!;
			const postBtn = section.querySelector<HTMLButtonElement>("[data-role='post-btn']")!;
			const charCount = section.querySelector<HTMLElement>("[data-role='char-count']")!;

			const updateState = () => {
				const length = input.value.trim().length;
				charCount.textContent = input.value.length.toString();
				postBtn.disabled = length === 0 || length > 1000;
			};

			input.addEventListener('input', updateState);

			postBtn.addEventListener('click', async () => {
				const content = input.value.trim();
				if (!content) return;

				postBtn.disabled = true;
				postBtn.textContent = 'Posting…';

				// Author name, avatar, user id and timestamp are set by the database trigger
				const { data, error } = await supabase
					.from('comments')
					.insert({ content, post_slug: postSlug })
					.select('id, content, created_at, author_name, author_avatar')
					.single();

				postBtn.textContent = 'Post';

				if (error) {
					console.error('Error posting comment:', error);
					alert(error.code === 'P0001' ? error.message : 'Error posting comment. Please try again.');
					updateState();
					return;
				}

				input.value = '';
				updateState();
				addComments([data]);
			});
		}
	}
</script>
